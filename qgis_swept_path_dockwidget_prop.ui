        <item row="83" column="0">
         <widget class="QLabel" name="lblRouteFailDistance">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Fail distance&lt;/b&gt;&lt;/p&gt;&lt;p&gt;How far the vehicle may travel while off the route (see&lt;br/&gt;'Max. deviation') before the route is declared impossible.&lt;br/&gt;It is a travelled distance, so a standing vehicle never&lt;br/&gt;fails this way.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 2.0 m&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Fail distance</string>
          </property>
          <property name="wordWrap">
