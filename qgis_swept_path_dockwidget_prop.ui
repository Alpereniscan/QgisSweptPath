        <item row="61" column="0">
         <widget class="QLabel" name="lblRouteSteerInstant">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Instant steering&lt;/b&gt;&lt;/p&gt;&lt;p&gt;On: the steering wheel jumps straight to the angle the route&lt;br/&gt;needs (stop-start assumption, as in CAD swept-path tools).&lt;br/&gt;Off: the wheel turns at the normal steering speed ('Steering&lt;br/&gt;time'), so tight turns need more distance to set up.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: on&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Instant steering</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
