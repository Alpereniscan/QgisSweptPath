        <item row="109" column="0">
         <widget class="QLabel" name="lblRouteTrailerLookaheadFactor">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Trailer look-ahead (x axle distance)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Look-ahead for the trailer axle as a fraction of the hitch-&lt;br/&gt;to-axle distance. The larger of this and the minimum look-&lt;br/&gt;ahead is used. Smaller = the trailer follows the line more&lt;br/&gt;tightly; values that are too small make the controller&lt;br/&gt;unstable. Larger = smoother but it cuts curves and can hunt.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 0.50&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Trailer look-ahead (x axle distance)</string>
          </property>
          <property name="wordWrap">
