          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Reverse speed with trailer&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Top speed when reversing with a trailer. The lower of this&lt;br/&gt;value and the reverse speed is used. A trailer reacts to&lt;br/&gt;steering with a delay, so a lower speed leaves more time to&lt;br/&gt;correct the angle between tractor and trailer.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 1.00 m/s&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
