        <item row="77" column="0">
         <widget class="QLabel" name="lblRouteSpacing">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Path point spacing&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Distance between the points of the path the vehicle follows.&lt;br/&gt;Smaller = smoother curvature but slower; larger = faster but&lt;br/&gt;coarser. The 'Search window' under advanced gains is counted&lt;br/&gt;in points, so a smaller spacing shortens the distance it&lt;br/&gt;covers. Rarely needs changing.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 0.25 m&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Path point spacing</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
