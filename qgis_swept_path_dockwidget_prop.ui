        <item row="101" column="0">
         <widget class="QLabel" name="lblRouteSearchWindow">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Search window&lt;/b&gt;&lt;/p&gt;&lt;p&gt;How many path points ahead of the current position are&lt;br/&gt;searched to find where the vehicle is on the path (distance&lt;br/&gt;= points times point spacing). It stops the search from&lt;br/&gt;jumping to a later part of a path that crosses itself. Raise&lt;br/&gt;it only if the vehicle can move further than this between&lt;br/&gt;two frames.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 60 pts&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Search window</string>
          </property>
