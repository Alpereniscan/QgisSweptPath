        <item row="76" column="0">
         <widget class="QLabel" name="lblRouteLeadin">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Lead-in length&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Length of a straight run-in added at the start of every run,&lt;br/&gt;in the direction the vehicle is moving. Without it a first&lt;br/&gt;click to the side of the vehicle would demand a sideways&lt;br/&gt;step. Raise it if the vehicle swings sharply at the start of&lt;br/&gt;a run. 0 switches it off. Corner smoothing also rounds the&lt;br/&gt;end of the run-in, so the part that stays straight is&lt;br/&gt;shorter than this value.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 1.0 m&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Lead-in length</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
