        <item row="108" column="0">
         <widget class="QLabel" name="lblRouteTrailerInnerGain">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Articulation gain&lt;/b&gt;&lt;/p&gt;&lt;p&gt;How fast the angle between tractor and trailer is pulled to&lt;br/&gt;its target (per metre travelled; the length constant is 1 /&lt;br/&gt;value metres). Higher = snappier but it may overshoot; lower&lt;br/&gt;= calmer. Keep it clearly faster than the trailer look-&lt;br/&gt;ahead.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 1.5 1/m&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Articulation gain</string>
          </property>
