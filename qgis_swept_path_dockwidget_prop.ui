        <item row="78" column="0">
         <widget class="QLabel" name="lblRouteEndTolerance">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Run end tolerance&lt;/b&gt;&lt;/p&gt;&lt;p&gt;A run counts as finished when the followed point is this&lt;br/&gt;close to the end of its path. Lower = the vehicle ends&lt;br/&gt;closer to your last click but needs more precise tracking;&lt;br/&gt;higher = it stops earlier.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 0.30 m&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
