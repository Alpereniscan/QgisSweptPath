        <item row="98" column="0">
         <widget class="QLabel" name="lblRouteReverseLookaheadFactor">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Reverse look-ahead (x wheelbase)&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Reverse look-ahead without a trailer, as a fraction of the&lt;br/&gt;wheelbase: the point on the line that the rear axle aims at.&lt;br/&gt;The larger of this and the minimum look-ahead is used.&lt;br/&gt;Smaller = tighter tracking but it can oscillate; larger =&lt;br/&gt;smoother but it cuts curves.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 0.60&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Reverse look-ahead (x wheelbase)</string>
          </property>
          <property name="wordWrap">
