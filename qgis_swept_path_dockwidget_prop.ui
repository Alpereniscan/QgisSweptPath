        </item>
        <item row="97" column="0">
         <widget class="QLabel" name="lblRouteForwardSoftening">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Forward cross-track gain&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Forward steering correction for the distance from the line:&lt;br/&gt;the correction is the arctangent of (distance / this value).&lt;br/&gt;Smaller = pulls back onto the line harder, but too small&lt;br/&gt;makes the vehicle weave. Larger = a gentler return.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 1.2 m&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Forward cross-track gain</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
