        <item row="75" column="0">
         <widget class="QLabel" name="lblRouteSmoothing">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Corner smoothing&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Rounds the corners of the drawn line before the vehicle&lt;br/&gt;follows it (Chaikin corner cutting). 0 follows the clicked&lt;br/&gt;points exactly, with sharp corners a vehicle cannot drive.&lt;br/&gt;Any value from 1 cuts a 90 degree corner by about 0.18 times&lt;br/&gt;the length of the adjacent legs; higher values only make the&lt;br/&gt;rounded curve smoother. Add clicks close to a corner to cut&lt;br/&gt;it less.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Default: 2&lt;/i&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Corner smoothing</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
